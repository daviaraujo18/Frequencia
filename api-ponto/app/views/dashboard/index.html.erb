<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>Dashboard</h2>
  <div>
    <%= link_to "Usuários", users_path, class: "btn btn-outline-primary btn-sm" %>
    <%= link_to "Registros", time_records_path, class: "btn btn-outline-primary btn-sm" %>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="card text-bg-primary">
      <div class="card-body">
        <h5 class="card-title"><%= @total_usuarios %></h5>
        <p class="card-text">Total de Usuários</p>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card text-bg-success">
      <div class="card-body">
        <h5 class="card-title"><%= @usuarios_ativos %></h5>
        <p class="card-text">Usuários Ativos</p>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card text-bg-warning">
      <div class="card-body">
        <h5 class="card-title"><%= @usuarios_com_digitais %></h5>
        <p class="card-text">Com Digitais</p>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card text-bg-info">
      <div class="card-body">
        <h5 class="card-title"><%= @registros_hoje %></h5>
        <p class="card-text">Batidas Hoje</p>
      </div>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card">
      <div class="card-body text-center">
        <h3><%= @registros_semana %></h3>
        <p class="text-muted">Batidas na última semana</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card">
      <div class="card-body text-center">
        <h3><%= @registros_mes %></h3>
        <p class="text-muted">Batidas no último mês</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card">
      <div class="card-body text-center">
        <h3><%= @usuarios_inativos %></h3>
        <p class="text-muted">Usuários Inativos</p>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span>Últimas Batidas</span>
    <%= link_to "Ver todas", time_records_path, class: "btn btn-sm btn-outline-secondary" %>
  </div>
  <div class="card-body p-0">
    <table class="table table-striped mb-0">
      <thead>
        <tr>
          <th>Usuário</th>
          <th>Data/Hora</th>
          <th>Modo</th>
        </tr>
      </thead>
      <tbody>
        <% @ultimas_batidas.each do |tr| %>
          <tr>
            <td><%= tr.user&.nome_completo %></td>
            <td><%= l(tr.punched_at, format: :long) %></td>
            <td><span class="badge bg-<%= tr.authentication_mode == "biometric" ? "success" : "secondary" %>"><%= tr.authentication_mode %></span></td>
          </tr>
        <% end %>
        <% if @ultimas_batidas.empty? %>
          <tr><td colspan="3" class="text-muted text-center">Nenhuma batida registrada</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
