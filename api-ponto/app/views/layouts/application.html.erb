<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application" %>
  <title>Estação Ponto</title>
</head>
<body class="hold-transition sidebar-mini layout-fixed">
  <div class="wrapper">
    <!-- Navbar -->
    <nav class="main-header navbar navbar-expand navbar-white navbar-light">
      <!-- Left navbar links -->
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link" data-widget="pushmenu" href="#" role="button">
            <i class="fas fa-bars"></i>
          </a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
          <span class="nav-link fw-bold text-primary">
            <i class="fas fa-gavel"></i> TJPI
          </span>
        </li>
      </ul>

      <!-- Right navbar links -->
      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <span id="status-conexao" class="nav-link" title="Conectado">
            <i class="fas fa-circle text-success" style="font-size: 10px;"></i>
          </span>
        </li>
        <li class="nav-item">
          <span id="relogio" class="nav-link"><%= l(Time.current, format: :time_only) %></span>
        </li>
      </ul>
    </nav>

    <!-- Sidebar -->
    <aside class="main-sidebar sidebar-dark-primary elevation-4">
      <a href="/presenca/PontoDePresenca" class="brand-link">
        <span class="brand-text fw-light">Estação Ponto — TJPI</span>
      </a>
      <div class="sidebar">
        <nav class="mt-2">
          <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu">
            <li class="nav-item">
              <a href="/presenca/PontoDePresenca" class="nav-link">
                <i class="nav-icon fas fa-home"></i>
                <p>Início</p>
              </a>
            </li>
            <li class="nav-item">
              <a href="/presenca/PontoDePresenca" class="nav-link">
                <i class="nav-icon fas fa-clock"></i>
                <p>Ponto de Presença</p>
              </a>
            </li>
            <li class="nav-item">
              <a href="#" class="nav-link disabled">
                <i class="nav-icon fas fa-users"></i>
                <p>Frequentadores</p>
              </a>
            </li>
          </ul>
        </nav>
        <!-- Sidebar footer with version -->
        <div class="sidebar-footer" style="position: absolute; bottom: 10px; padding: 0 1rem; width: 100%;">
          <small class="text-muted">v1.0.0</small>
        </div>
      </div>
    </aside>

    <!-- Content Wrapper -->
    <div class="content-wrapper">
      <section class="content">
        <% if notice %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= notice %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>
        <% if alert %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= alert %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>
        <%= yield %>
      </section>
    </div>

    <!-- Hidden fields for JavaFX bridge -->
    <input type="hidden" id="codigoAtivacao" value="<%= yield(:codigo_ativacao).presence || "" %>">
    <input type="hidden" id="codigoUnicoMaquina" value="<%= yield(:codigo_unico_maquina).presence || "" %>">
    <input type="hidden" id="digitaisHash" value="<%= yield(:digitais_hash).presence || "" %>">

    <%= javascript_importmap_tags "application" %>

    <!-- Sidebar state persistence + active menu highlight + bridge functions -->
    <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Sidebar state persistence via localStorage
      var savedState = localStorage.getItem('sidebar-collapsed');
      if (savedState === 'true') {
        document.body.classList.add('sidebar-collapse');
      }

      // Listen for sidebar toggle (AdminLTE pushmenu)
      var toggleBtn = document.querySelector('[data-widget="pushmenu"]');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', function() {
          setTimeout(function() {
            var isCollapsed = document.body.classList.contains('sidebar-collapse');
            localStorage.setItem('sidebar-collapsed', isCollapsed);
          }, 300);
        });
      }

      // Highlight active menu item based on current path
      var currentPath = window.location.pathname;
      document.querySelectorAll('.nav-sidebar a.nav-link').forEach(function(link) {
        if (link.getAttribute('href') === currentPath) {
          link.classList.add('active');
        }
      });
    });

    /**
     * Bridge function: atualiza o relógio digital na navbar.
     * Chamado pela Estação JavaFX via The.inserirJavascript.
     * @param {string} horario - Horário formatado (HH:MM:SS)
     */
    function atualizaRelogioLocal(horario) {
      var el = document.getElementById('relogio');
      if (el) el.textContent = horario;
    }

    /**
     * Solicita à Estação JavaFX que atualize o relógio local ('atualizarRelogioLocal'
     * é o comando reconhecido por listeners.Operacao#ATUALIZAR_RELOGIO_LOCAL no
     * código Java). A Estação responde chamando atualizaRelogioLocal(horario) acima.
     * Sem este ping periódico, o relógio fica parado — a função receptora sozinha
     * nunca é invocada.
     */
    setInterval(function() {
      alert('atualizarRelogioLocal');
    }, 1000);

    /**
     * Bridge function: atualiza o indicador de status da conexão.
     * Chamado pela Estação JavaFX via The.inserirJavascript.
     * @param {boolean} conectado - true se conectado, false se desconectado
     */
    function atualizaStatusConexao(conectado) {
      var el = document.getElementById('status-conexao');
      if (el) {
        el.innerHTML = conectado
          ? '<i class="fas fa-circle text-success" style="font-size: 10px;" title="Conectado"></i>'
          : '<i class="fas fa-circle text-danger" style="font-size: 10px;" title="Desconectado"></i>';
        el.title = conectado ? 'Conectado' : 'Desconectado';
      }
    }
    </script>
  </div>
</body>
</html>
