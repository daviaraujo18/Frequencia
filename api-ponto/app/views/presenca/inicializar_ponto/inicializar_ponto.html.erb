<%# Preenche os campos ocultos no layout %>
<% content_for :codigo_ativacao, @codigo_ativacao %>
<% content_for :codigo_unico_maquina, @codigo_unico_maquina %>

<% if @codigo_ativacao.present? %>
  <div id="loading">Inicializando...</div>

  <script>
    window.onload = function() {
      alert('recuperarFrequentadores');

      setTimeout(function() {
        window.location.href = '/presenca/PontoDePresenca';
      }, 2000);
    };
  </script>
<% else %>
  <div id="error" style="color: red; text-align: center; margin-top: 50px; font-family: sans-serif;">
    <h2>Erro de Ativação</h2>
    <p>Código de ativação não informado. Verifique a configuração da estação.</p>
  </div>
<% end %>
