<%# Preenche os campos ocultos definidos no layout (kiosk.html.erb) %>
<% content_for :codigo_ativacao, @codigo_ativacao %>
<% content_for :codigo_unico_maquina, @codigo_unico_maquina %>
<% content_for :digitais_hash, @digitais_hash %>

<%# O cabeçalho "ESTAÇÃO PONTO DE PRESENÇA / TRIBUNAL DE JUSTIÇA DO PIAUÍ" já
    é renderizado nativamente pelo JavaFX (imagem topo.png, acima do WebView
    — ver Main.fxml) — não deve ser duplicado aqui. %>
<div class="orgao">598 - STIC- COORDENAÇÃO DE SOFT</div>

<h1 id="statusMessage" class="status-message">Coloque a digital no leitor.</h1>

<%
  # O nome só deve aparecer logo após bater o ponto — não em qualquer
  # carregamento da página. "Recente" = registrado nos últimos 10s (cobre o
  # reload que o próprio fluxo de login manual/simular digital dispara).
  registro_recente = @ultimo_registro.present? && @ultimo_registro.created_at > 10.seconds.ago
  if registro_recente
    tipo_label = @ultimo_registro.punch_type == "entry" ? "Entrada" : (@ultimo_registro.punch_type == "exit" ? "Saída" : nil)
    frequentador_inicial = tipo_label ? "#{@ultimo_registro.user.nome_completo} — #{tipo_label} (#{l(@ultimo_registro.punched_at, format: :short)})" : ""
  else
    frequentador_inicial = ""
  end
%>

<div class="main">
  <div class="clock-block">
    <div id="clockDigital" class="clock">--:--</div>
    <% data_atual = Time.current.to_date %>
    <% dia_semana = I18n.t("date.day_names")[data_atual.wday].sub(/-feira$/, "").capitalize %>
    <% mes = I18n.t("date.month_names")[data_atual.month].capitalize %>
    <div id="clockDate" class="clock-date"><%= "#{dia_semana}, #{data_atual.day} de #{mes} de #{data_atual.year}" %></div>
    <div id="frequentadorInfo" class="frequentador-info"><%= frequentador_inicial %></div>
  </div>
</div>

<div id="loginManualForm" class="login-corner">
  <form onsubmit="registrarPontoManual(); return false;">
    <div><input type="text" name="accessKey" id="accessKey" placeholder="login"></div>
    <div><input type="password" name="plainPassword" id="plainPassword" placeholder="senha"></div>
    <div><button type="submit">Registrar</button></div>
    <div id="loginFeedback" class="login-feedback" style="display:none;"></div>
  </form>
</div>

<div id="feedbackToast" class="feedback-toast" style="display:none;"></div>
<div id="lockOverlay" class="lock-overlay" style="display:none;"></div>

<a href="/presenca/Frequentador?type=create" class="cadastro-digital-link">Cadastrar digital</a>

<script>
    window.comando = "NADA";
    var feedbackTimeout;

    function changeInfoDigital(status, message) {
        exibeToast(status, message);
    }

    function exibeToast(status, message) {
        var toast = document.getElementById('feedbackToast');
        if (!toast) return;
        toast.textContent = message;
        toast.className = 'feedback-toast ' + (status === 'erro' ? 'feedback-error' : 'feedback-ok');
        toast.style.display = 'block';
        setTimeout(function() { toast.style.display = 'none'; }, 4000);
    }

    function lock() {
        var overlay = document.getElementById('lockOverlay');
        if (overlay) overlay.style.display = 'block';
    }

    function unlock() {
        var overlay = document.getElementById('lockOverlay');
        if (overlay) overlay.style.display = 'none';
    }

    /**
     * Bridge function: envia os registros de ponto coletados offline para a API
     * (fluxo biométrico em lote). JS puro — sem fetch()/Promise complexos, por
     * compatibilidade com o WebKit antigo do WebView JavaFX.
     */
    function sincronizaPonto(dados, codAtivacao) {
        lock();
        var codigo = codAtivacao || (document.getElementById('codigoAtivacao') || {}).value || '';
        return new Promise(function(resolve, reject) {
            var xhr = new XMLHttpRequest();
            xhr.open('POST', '/presenca/ajax/SincronizarRegistrosPonto', true);
            xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
            xhr.onload = function() {
                unlock();
                if (xhr.status < 200 || xhr.status >= 300) {
                    exibeToast('erro', 'Falha ao sincronizar o ponto.');
                    alert('naosincronizado');
                    reject(new Error('HTTP ' + xhr.status));
                    return;
                }
                var data = xhr.responseText;
                if (data === 'sincronizado') {
                    alert('Sincronizando');
                } else {
                    exibeToast('erro', 'Falha ao sincronizar o ponto.');
                    alert('naosincronizado');
                }
                resolve(data);
            };
            xhr.onerror = function() {
                unlock();
                exibeToast('erro', 'Erro de comunicação ao sincronizar o ponto.');
                alert('naosincronizado');
                reject(new Error('Falha de rede'));
            };
            xhr.send('registros=' + encodeURIComponent(dados) + '&codAtivacao=' + encodeURIComponent(codigo));
        });
    }

    /**
     * Bridge function: chamada pela Estação (DadosFrequentadores.init) depois
     * de baixar os dados de frequentadores. Sem spinner dedicado nesta tela —
     * só existe pra não lançar ReferenceError (ver histórico de bugs).
     */
    function aguardarDigital() {}

    /**
     * Bridge function: chamada pela Estação (Operacao#RECUPERAR_FREQUENTADORES)
     * logo após iniciar o download de frequentadores. Mesma situação acima.
     */
    function removeLoading() {}

    /**
     * Bridge function: processa comandos vindos da Estação JavaFX. Atualiza a
     * mensagem principal com o nome/status de quem bateu o ponto.
     */
    function process(acao, dadosJson) {
        if (acao !== 'DIGITAL_RECONHECIDA') return;

        var dados;
        try {
            dados = JSON.parse(dadosJson);
        } catch (e) {
            exibeToast('erro', 'Dados inválidos recebidos da Estação.');
            return;
        }
        if (!dados || typeof dados !== 'object') {
            exibeToast('erro', 'Dados inválidos recebidos da Estação.');
            return;
        }

        var isEntry = dados.punchType === 'entry';
        var infoEl = document.getElementById('frequentadorInfo');
        var tipoLabel = isEntry ? 'Entrada' : 'Saída';
        if (infoEl) {
            infoEl.textContent = (dados.nome || 'Frequentador') + ' — ' + tipoLabel + (dados.horario ? ' (' + dados.horario + ')' : '');
        }

        exibeToast('ok', (dados.nome || 'Frequentador') + (isEntry ? ' entrou' : ' saiu') + '.');

        setTimeout(function() {
            if (infoEl) infoEl.textContent = '';
        }, 2000);
    }

    /**
     * Bridge function: atualiza o relógio grande da tela.
     * Chamado pela Estação JavaFX via The.inserirJavascript.
     * @param {string} horario - horário formatado (ex: HH:MM:SS)
     */
    function atualizaRelogioLocal(horario) {
        // A Estação manda "DiaSemana,Dia,MêsExtenso,Ano,HH:MM" (ThreadRelogio#calculaHorario,
        // formato legado) — separamos aqui: hora grande no meio, data menor embaixo.
        var partes = horario.split(',');
        var el = document.getElementById('clockDigital');
        var dateEl = document.getElementById('clockDate');
        if (partes.length === 5) {
            var diaSemana = partes[0], dia = partes[1], mes = partes[2], ano = partes[3], hora = partes[4];
            if (el) el.textContent = hora;
            if (dateEl) dateEl.textContent = diaSemana + ', ' + dia + ' de ' + mes + ' de ' + ano;
        } else if (el) {
            el.textContent = horario;
        }
    }

    /**
     * Bridge function: exibe mensagem de feedback no formulário de login manual.
     * Chamado pela Estação JavaFX via The.inserirJavascript.
     */
    window.changeMensagemStatus = function(mensagem) {
        var el = document.getElementById('loginFeedback');
        if (!el) return;
        if (feedbackTimeout) clearTimeout(feedbackTimeout);
        el.textContent = mensagem;
        el.style.display = 'block';
        feedbackTimeout = setTimeout(function() {
            el.style.display = 'none';
        }, 5000);
    };

    /**
     * Login manual: dispara alert para Estação JavaFX interceptar
     * (OnAlertListener -> Operacao.LOGINMANUAL). Ligado via
     * onsubmit="registrarPontoManual(); return false;" no <form> — padrão
     * inline mais compatível possível, sem addEventListener/preventDefault().
     */
    function registrarPontoManual() {
        alert('loginManual');
    }

    document.addEventListener('DOMContentLoaded', function() {
        alert('downloadFrequentadores');
        alert('horarioServidorAtual:<%= Time.current.day %>:<%= Time.current.month %>:<%= Time.current.year %>:<%= Time.current.hour %>:<%= "%02d" % Time.current.min %>');

        <% if registro_recente %>
        // Nome renderizado pelo servidor (registro recente) — some depois de
        // alguns segundos, caso a tela fique aberta sem novo recarregamento.
        setTimeout(function() {
            var infoEl = document.getElementById('frequentadorInfo');
            if (infoEl) infoEl.textContent = '';
        }, 2000);
        <% end %>
    });

    /**
     * Solicita à Estação JavaFX que atualize o relógio local a cada segundo
     * ('atualizarRelogioLocal' é o comando reconhecido por
     * listeners.Operacao#ATUALIZAR_RELOGIO_LOCAL no código Java). A Estação
     * responde chamando atualizaRelogioLocal(horario) acima. Sem esse ping
     * periódico o relógio nunca é atualizado (só existia antes no layout
     * "application", que esta página não usa mais).
     */
    setInterval(function() {
        alert('atualizarRelogioLocal');
    }, 1000);
</script>

<style>
    * { box-sizing: border-box; }
    html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        font-family: Georgia, 'Times New Roman', serif;
        background: #fdfdfb;
        color: #153B65;
        overflow: hidden;
    }

    .orgao {
        text-align: center;
        font-family: Arial, sans-serif;
        font-size: 0.7em;
        color: #666;
        margin: 10px 0;
    }

    .status-message {
        font-size: 2.3em;
        font-weight: normal;
        color: #1b2c47;
        text-align: center;
        margin: 70px 0 4px;
    }

    .frequentador-info {
        font-family: Arial, sans-serif;
        font-size: 1em;
        color: #555;
        text-align: center;
        min-height: 1.2em;
    }

    .main {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        margin-top: 30px;
    }

    .clock-block {
        text-align: center;
    }
    .clock {
        font-family: Arial, sans-serif;
        font-size: 3.4em;
        font-weight: bold;
        color: #1b2c47;
        font-variant-numeric: tabular-nums;
        line-height: 1;
    }
    .clock-date {
        font-family: Georgia, serif;
        font-size: 1em;
        color: #1b2c47;
        margin-top: 4px;
    }

    /* Formulário de login manual: propositalmente sem estilo customizado
       (inputs/botão no visual padrão do navegador), igual à tela real da
       Estação — só posicionamento no canto. */
    .login-corner {
        position: fixed;
        left: 10px;
        bottom: 10px;
    }
    .login-feedback {
        color: #b02a2a;
        font-family: Arial, sans-serif;
        font-size: 0.8em;
        max-width: 160px;
    }

    .feedback-toast {
        position: fixed;
        top: 12px;
        left: 50%;
        transform: translateX(-50%);
        font-family: Arial, sans-serif;
        padding: 10px 18px;
        border-radius: 6px;
        font-size: 0.95em;
        z-index: 1100;
    }
    .feedback-toast.feedback-ok { background: #d4edda; color: #155724; }
    .feedback-toast.feedback-error { background: #f8d7da; color: #721c24; }

    .lock-overlay {
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(255,255,255,0.4);
        z-index: 1000;
        cursor: wait;
    }

    .cadastro-digital-link {
        position: fixed;
        right: 10px;
        bottom: 10px;
        font-family: Arial, sans-serif;
        font-size: 0.8em;
        color: #888;
    }
</style>
