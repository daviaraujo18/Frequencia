<%# Task 23.8 — Links de navegação entre as telas de autenticação Devise
    (padrão do generator Devise, versão adaptada: sem registrations — a rota
    é `skip: :registrations`; sem confirmable/unlockable — módulos não
    ativos no User). `devise_mapping`/`controller_name` vêm do
    DeviseController; helpers `new_session_path`/`new_password_path` das
    rotas /u/* (task 23.6). %>
<%- if controller_name != "sessions" && devise_mapping.recoverable? %>
  <%= link_to t("devise.links.sign_in"), new_session_path(resource_name) %>
  <br />
<% end %>

<%- if devise_mapping.recoverable? && controller_name != "passwords" %>
  <%= link_to t("devise.links.forgot_your_password"), new_password_path(resource_name) %>
  <br />
<% end %>