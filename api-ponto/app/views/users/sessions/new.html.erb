<%# Task 23.8 — View real do Devise para login (Users::SessionsController#new).
    Substitui o reuso temporário de "admin/sessions/new" (task 23.6). Mesmo
    layout "login" e mesma identidade visual AdminLTE 4 da tela legada em
    /login (Admin::SessionsController), mas o form submete para a rota
    Devise (`session_path(resource_name)` -> /u/sign_in), que passa pelo
    Warden e usa `User#find_for_database_authentication`/`#valid_password?`
    (sobrescritos no model para rotear usuários com `cpf` para o Pessoas2 —
    ver app/models/user.rb). Nenhuma lógica de autenticação é alterada aqui,
    apenas a tela.
    Refino da 23.8: todos os textos via I18n (devise.* — pt-BR estrito),
    header do card via partial compartilhado e link "Esqueceu sua senha?"
    (recoverable) via `users/shared/links`. %>
<div class="card shadow-lg">
  <div class="card-body p-5">
    <%= render "users/shared/card_header",
               app_title: t("devise.sessions.new.app_title"),
               subtitle: t("devise.sessions.new.subtitle") %>

    <% if flash[:alert] %>
      <div class="alert alert-danger"><i class="fas fa-triangle-exclamation me-1"></i> <%= flash[:alert] %></div>
    <% end %>
    <% if flash[:notice] %>
      <div class="alert alert-success"><i class="fas fa-circle-check me-1"></i> <%= flash[:notice] %></div>
    <% end %>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { data: { turbo: false } }) do |f| %>
      <div class="mb-3">
        <%= f.label :username, t("devise.sessions.new.username"), class: "form-label" %>
        <div class="input-group">
          <span class="input-group-text"><i class="fas fa-user"></i></span>
          <%= f.text_field :username, class: "form-control", autofocus: true, placeholder: "nome.sobrenome" %>
        </div>
      </div>
      <div class="mb-3">
        <%= f.label :password, t("devise.sessions.new.password"), class: "form-label" %>
        <div class="input-group">
          <span class="input-group-text"><i class="fas fa-lock"></i></span>
          <%= f.password_field :password, class: "form-control", placeholder: "Sua senha", autocomplete: "current-password" %>
        </div>
      </div>
      <%# Débito 23.6 resolvido: rememberable ativo no User e checkbox exposto
          no form novo — o cookie de remember só é emitido se o param
          user[remember_me] for enviado. %>
      <% if devise_mapping.rememberable? %>
        <div class="form-check mb-3">
          <%= f.check_box :remember_me, class: "form-check-input" %>
          <%= f.label :remember_me, t("devise.sessions.new.remember_me"), class: "form-check-label" %>
        </div>
      <% end %>
      <%= f.submit t("devise.sessions.new.sign_in"), class: "btn btn-primary w-100" %>
    <% end %>

    <hr class="my-4">
    <%= render "users/shared/links" %>
  </div>
</div>