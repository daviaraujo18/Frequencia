<% content_for :page_title, "Lista de Registro de Frequência" %>

<div class="card card-primary card-outline mb-4">
  <div class="card-header">
    <h3 class="card-title"><i class="bi bi-funnel me-1"></i> Filtros</h3>
  </div>
  <div class="card-body">
    <%= form_tag frequencia_path, method: :get, class: "row g-2 align-items-end", data: { turbo: false } do %>
      <div class="col-auto">
        <%= label_tag :data, "Data", class: "form-label" %>
        <%= date_field_tag :data, params[:data], class: "form-control form-control-sm" %>
      </div>
      <div class="col-auto">
        <%= label_tag :frequentador, "Frequentador", class: "form-label" %>
        <%= text_field_tag :frequentador, params[:frequentador], class: "form-control form-control-sm", placeholder: "Buscar por frequentador" %>
      </div>
      <div class="col-auto">
        <%= label_tag :estacao, "Estação", class: "form-label" %>
        <%= text_field_tag :estacao, params[:estacao], class: "form-control form-control-sm", placeholder: "Buscar por estação" %>
      </div>
      <div class="col-auto pb-1">
        <div class="form-check">
          <%= check_box_tag :ressalvas, "1", params[:ressalvas].present?, class: "form-check-input", id: "ressalvas", disabled: true, title: "Disponível quando os dados de ressalvas forem importados" %>
          <%= label_tag :ressalvas, "Ressalvas", class: "form-check-label" %>
        </div>
      </div>
      <div class="col-auto d-flex gap-1">
        <%= button_tag class: "btn btn-primary btn-sm" do %>
          <i class="bi bi-search"></i> Filtrar
        <% end %>
        <%= link_to frequencia_path, class: "btn btn-outline-secondary btn-sm" do %>
          <i class="bi bi-x-lg"></i> Limpar
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<div class="card card-primary card-outline">
  <div class="card-header">
    <h3 class="card-title"><i class="bi bi-calendar-check me-1"></i> Frequência</h3>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-striped mb-0">
        <thead>
          <tr>
            <th>Frequentador</th>
            <th>Data</th>
            <th>Operação</th>
            <th>Modo</th>
            <th>Lotação Época</th>
            <th>Estação</th>
            <th>Gerência</th>
          </tr>
        </thead>
        <tbody>
          <% @registros.each do |registro| %>
            <tr>
              <td><%= registro[:frequentador] %></td>
              <td><%= registro[:data] %></td>
              <td><%= registro[:operacao] %></td>
              <td><%= registro[:modo] %></td>
              <td><%= registro[:lotacao_epoca] %></td>
              <td><%= registro[:estacao] %></td>
              <td><%= registro[:gerencia] %></td>
            </tr>
          <% end %>
          <% if @registros.empty? %>
            <tr><td colspan="7" class="text-muted text-center">Nenhum registro encontrado</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
