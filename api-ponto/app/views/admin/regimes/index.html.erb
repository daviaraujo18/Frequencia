<% content_for :page_title, "Gerência de Regimes" %>

<div class="row mb-3">
  <div class="col-sm-6">
    <p class="text-muted mb-0"><%= @regimes.size %> regime(s) cadastrado(s)</p>
  </div>
  <div class="col-sm-6 text-sm-end">
    <%= link_to new_regime_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i> Novo Regime
    <% end %>
  </div>
</div>

<div class="card card-primary card-outline mb-4">
  <div class="card-header">
    <h3 class="card-title"><i class="bi bi-funnel me-1"></i> Filtros</h3>
  </div>
  <div class="card-body">
    <%= form_tag regimes_path, method: :get, class: "row g-2 align-items-end", data: { turbo: false } do %>
      <div class="col-auto">
        <%= label_tag :nome, "Nome", class: "form-label" %>
        <%= text_field_tag :nome, params[:nome], class: "form-control form-control-sm", placeholder: "Buscar por nome" %>
      </div>
      <div class="col-auto">
        <%= label_tag :categoria, "Categoria", class: "form-label" %>
        <%= select_tag :categoria,
              options_for_select(Regime::CATEGORIAS_DISPONIVEIS.map { |c| [ Regime::CATEGORIAS_LABELS[c], c ] }, params[:categoria]),
              include_blank: "Todos",
              class: "form-select form-select-sm" %>
      </div>
      <div class="col-auto">
        <%= label_tag :modalidade, "Modalidade", class: "form-label" %>
        <%= select_tag :modalidade,
              options_for_select(Regime::MODALIDADES_DISPONIVEIS.map { |m| [ Regime::MODALIDADES_LABELS[m], m ] }, params[:modalidade]),
              include_blank: "Todas",
              class: "form-select form-select-sm" %>
      </div>
      <div class="col-auto d-flex gap-1">
        <%= button_tag class: "btn btn-primary btn-sm" do %>
          <i class="bi bi-search"></i> Filtrar
        <% end %>
        <%= link_to regimes_path, class: "btn btn-outline-secondary btn-sm" do %>
          <i class="bi bi-x-lg"></i> Limpar
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<div class="card card-primary card-outline">
  <div class="card-header">
    <h3 class="card-title"><i class="bi bi-clock-history me-1"></i> Lista de Regimes</h3>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-striped mb-0">
        <thead>
          <tr>
            <th>Categoria</th>
            <th>Nome</th>
            <th>Modalidade</th>
            <th>Resumo</th>
            <th>Meta Semanal</th>
            <th>Gerência</th>
          </tr>
        </thead>
        <tbody>
          <% @regimes.each do |regime| %>
            <tr>
              <td><%= regime.categorias.map { |c| Regime::CATEGORIAS_LABELS[c] || c }.join(", ") %></td>
              <td><%= regime.nome %></td>
              <td><%= Regime::MODALIDADES_LABELS[regime.modalidade] || regime.modalidade %></td>
              <td><%= regime.resumo %></td>
              <td><%= regime.meta_semanal %></td>
              <td class="text-end">
                <div class="d-flex gap-1 justify-content-end">
                  <%= link_to edit_regime_path(regime), class: "btn btn-xs btn-outline-primary" do %>
                    <i class="bi bi-pencil"></i>
                  <% end %>
                  <%= button_to regime_path(regime), method: :delete, class: "btn btn-xs btn-outline-danger", data: { turbo_confirm: "Tem certeza que deseja excluir este regime?" } do %>
                    <i class="bi bi-trash"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
          <% if @regimes.empty? %>
            <tr><td colspan="6" class="text-muted text-center">Nenhum regime cadastrado</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
