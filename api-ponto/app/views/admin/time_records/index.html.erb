<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>Registros de Ponto</h2>
  <span class="text-muted">Mostrando até <%= Admin::TimeRecordsController::PER_PAGE %> de <%= @total %> registros</span>
</div>

<div class="card mb-3">
  <div class="card-body">
    <%= form_tag time_records_path, method: :get, class: "row g-2 align-items-end", data: { turbo: false } do %>
      <div class="col-auto">
        <%= label_tag :id, "ID", class: "form-label" %>
        <%= text_field_tag :id, params[:id], class: "form-control form-control-sm", placeholder: "ID" %>
      </div>
      <div class="col-auto">
        <%= label_tag :start_date, "De", class: "form-label" %>
        <%= date_field_tag :start_date, params[:start_date], class: "form-control form-control-sm" %>
      </div>
      <div class="col-auto">
        <%= label_tag :end_date, "Até", class: "form-label" %>
        <%= date_field_tag :end_date, params[:end_date], class: "form-control form-control-sm" %>
      </div>
      <div class="col-auto">
        <%= label_tag :user_id, "Usuário", class: "form-label" %>
        <%= select_tag :user_id, options_from_collection_for_select(User.order(:nome_completo), :id, :nome_completo, params[:user_id]), include_blank: "Todos", class: "form-select form-select-sm" %>
      </div>
      <div class="col-auto">
        <%= submit_tag "Filtrar", class: "btn btn-primary btn-sm" %>
        <%= link_to "Limpar", time_records_path, class: "btn btn-outline-secondary btn-sm" %>
      </div>
    <% end %>
  </div>
</div>

<div class="card">
  <div class="card-body p-0">
    <table class="table table-striped mb-0">
      <thead>
        <tr>
          <th>ID</th>
          <th>Usuário</th>
          <th>Username</th>
          <th>Data/Hora Batida</th>
          <th>Modo</th>
          <th>Raw Data</th>
          <th>Recebido em</th>
        </tr>
      </thead>
      <tbody>
        <% @records.each do |tr| %>
          <tr>
            <td><%= tr.id %></td>
            <td><%= tr.user&.nome_completo %></td>
            <td><code><%= tr.user&.username %></code></td>
            <td><%= l(tr.punched_at, format: :long) %></td>
            <td><span class="badge bg-<%= tr.authentication_mode == "biometric" ? "success" : "secondary" %>"><%= tr.authentication_mode %></span></td>
            <td><small><code><%= tr.raw_data %></code></small></td>
            <td><%= l(tr.created_at, format: :short) %></td>
          </tr>
        <% end %>
        <% if @records.empty? %>
          <tr><td colspan="7" class="text-muted text-center">Nenhum registro encontrado</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
