<% content_for :page_title, "Versões da Estação de Ponto" %>
<% content_for :page_actions do %>
  <%= link_to "Cadastrar Nova Versão", "#" %>
<% end %>

<div class="row mb-3">
  <div class="col-sm-6">
    <p class="text-muted mb-0"><%= @versoes.size %> versão(ões)</p>
  </div>
</div>

<div class="card card-primary card-outline">
  <div class="card-header">
    <h3 class="card-title"><i class="bi bi-tags me-1"></i> Lista de Versões</h3>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-striped mb-0">
        <thead>
          <tr>
            <th>Versão</th>
            <th>Novidades</th>
            <th>Link</th>
          </tr>
        </thead>
        <tbody>
          <% @versoes.each do |versao| %>
            <tr>
              <td><%= versao[:versao] %></td>
              <td><%= versao[:novidades] %></td>
              <td><%= versao[:link] %></td>
            </tr>
          <% end %>
          <% if @versoes.empty? %>
            <tr><td colspan="3" class="text-muted text-center">Nenhuma versão cadastrada</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
