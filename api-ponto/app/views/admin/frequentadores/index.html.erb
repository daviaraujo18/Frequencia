<% content_for :page_title, "Gerência de Frequentadores" %>
<% content_for :page_actions do %>
  <%= link_to "Cadastrar novo frequentador", "#" %>
<% end %>

<div class="row mb-3">
  <div class="col-sm-6">
    <p class="text-muted mb-0"><%= @frequentadores.total_count %> frequentador(es)</p>
  </div>
</div>

<div class="card card-primary card-outline">
  <div class="card-header">
    <h3 class="card-title"><i class="bi bi-person-check me-1"></i> Lista de Frequentadores</h3>
  </div>
  <div class="card-body p-0">
    <%= form_tag frequentadores_path, method: :get, data: { turbo: false } do %>
      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
          <thead>
            <tr>
              <th style="width: 30%">Nome</th>
              <th style="width: 18%">Comarca/Órgão</th>
              <th style="width: 16%">Vínculo</th>
              <th style="width: 11%">Status</th>
              <th style="width: 11%">Digital</th>
              <th class="text-end" style="width: 14%">Gerência</th>
            </tr>
            <tr class="table-light align-middle">
              <td class="py-2">
                <%= text_field_tag :nome, params[:nome], class: "form-control form-control-sm", placeholder: "Buscar por nome..." %>
              </td>
              <td class="py-2">
                <%= text_field_tag :orgao, params[:orgao], class: "form-control form-control-sm", placeholder: "Órgão...", disabled: true, title: "Aguardando importação" %>
              </td>
              <td class="py-2">
                <%= select_tag :categoria,
                      options_for_select([
                        "Servidor Efetivo",
                        "Servidor Comissionado",
                        "Estagiário",
                        "Residente",
                        "Terceirizado",
                        "Auxiliar da Justiça",
                        "Cedido"
                      ], params[:categoria]),
                      include_blank: "Todos",
                      class: "form-select form-select-sm",
                      disabled: true,
                      title: "Aguardando importação" %>
              </td>
              <td class="py-2">
                <%= select_tag :status_filtro,
                      options_for_select([["Ativo", "1"], ["Inativo", "0"]], params[:status_filtro]),
                      include_blank: "Todos",
                      class: "form-select form-select-sm" %>
              </td>
              <td class="py-2">
                <%= select_tag :digital,
                      options_for_select([["Com Digital", "1"], ["Sem Digital", "0"]], params[:digital]),
                      include_blank: "Todas",
                      class: "form-select form-select-sm" %>
              </td>
              <td class="text-end py-2">
                <div class="d-flex gap-1 justify-content-end">
                  <%= button_tag class: "btn btn-primary btn-sm", title: "Filtrar" do %>
                    <i class="bi bi-search"></i> Filtrar
                  <% end %>
                  <%= link_to frequentadores_path, class: "btn btn-outline-secondary btn-sm", title: "Limpar Filtros" do %>
                    <i class="bi bi-x-lg"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          </thead>
          <tbody>
            <% @frequentadores.each do |user| %>
              <tr>
                <td><%= user.nome_completo %></td>
                <td class="text-muted">—</td>
                <td class="text-muted">—</td>
                <td>
                  <% if user.status == 1 %>
                    <span class="badge text-bg-success">Ativo</span>
                  <% else %>
                    <span class="badge text-bg-danger">Inativo</span>
                  <% end %>
                </td>
                <td>
                  <% if user.digitais_hash.present? %>
                    <span class="badge text-bg-info">Cadastrada</span>
                  <% else %>
                    <span class="badge text-bg-secondary">Não</span>
                  <% end %>
                </td>
                <td class="text-end">
                  <div class="d-flex gap-1 justify-content-end">
                    <%= link_to edit_user_path(user), class: "btn btn-xs btn-outline-primary", title: "Editar" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <% if user.status == 1 %>
                      <%= button_to user_path(user), method: :delete, class: "btn btn-xs btn-outline-danger", title: "Inativar", data: { turbo_confirm: "Tem certeza?" } do %>
                        <i class="bi bi-person-x"></i>
                      <% end %>
                    <% else %>
                      <%= button_to purge_user_path(user), method: :delete, class: "btn btn-xs btn-danger", title: "Excluir definitivamente", data: { turbo_confirm: "Tem certeza que deseja excluir definitivamente este usuário?" } do %>
                        <i class="bi bi-trash"></i>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
            <% if @frequentadores.empty? %>
              <tr><td colspan="6" class="text-muted text-center">Nenhum frequentador encontrado</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
  <!--begin::Card Footer-->
  <div class="card-footer clearfix">
    <div class="float-start pt-1 fs-7 text-body-secondary">
      Mostrando <%= @frequentadores.offset_value + 1 %> a <%= @frequentadores.offset_value + @frequentadores.length %> de <%= @frequentadores.total_count %> frequentadores
    </div>
    <%= paginate @frequentadores %>
  </div>
  <!--end::Card Footer-->
</div>

