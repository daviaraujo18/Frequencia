<div class="card shadow-lg">
  <div class="card-body p-5">
    <div class="text-center mb-4">
      <i class="bi bi-shield-lock fs-1 text-primary"></i>
      <h3 class="mt-2">API Ponto TJPI</h3>
      <p class="text-muted">Faça login no painel administrativo</p>
    </div>

    <% if flash[:alert] %>
      <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i> <%= flash[:alert] %></div>
    <% end %>

    <%= form_tag login_path, data: { turbo: false } do %>
      <div class="mb-3">
        <%= label_tag :username, "Usuário", class: "form-label" %>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-person"></i></span>
          <%= text_field_tag :username, params[:username], class: "form-control", autofocus: true, placeholder: "nome.sobrenome" %>
        </div>
      </div>
      <div class="mb-3">
        <%= label_tag :password, "Senha", class: "form-label" %>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-lock"></i></span>
          <%= password_field_tag :password, nil, class: "form-control", placeholder: "Sua senha" %>
        </div>
      </div>
      <%= submit_tag "Entrar", class: "btn btn-primary w-100" do %>
        <i class="bi bi-box-arrow-in-right me-1"></i> Entrar
      <% end %>
    <% end %>

    <hr class="my-4">
    <p class="text-muted text-center small mb-0">
      Credenciais de teste: <code>admin.admin</code> / <code>123456</code>
    </p>
  </div>
</div>
