<div class="card shadow">
  <div class="card-body p-4">
    <h3 class="text-center mb-4">API Ponto TJPI</h3>
    <p class="text-muted text-center">Faça login no painel administrativo</p>

    <% if flash[:alert] %>
      <div class="alert alert-danger"><%= flash[:alert] %></div>
    <% end %>

    <%= form_tag login_path, data: { turbo: false } do %>
      <div class="mb-3">
        <%= label_tag :username, "Usuário", class: "form-label" %>
        <%= text_field_tag :username, params[:username], class: "form-control", autofocus: true, placeholder: "nome.sobrenome" %>
      </div>
      <div class="mb-3">
        <%= label_tag :password, "Senha", class: "form-label" %>
        <%= password_field_tag :password, nil, class: "form-control", placeholder: "Sua senha" %>
      </div>
      <%= submit_tag "Entrar", class: "btn btn-primary w-100" %>
    <% end %>

    <hr class="my-4">
    <p class="text-muted text-center small">Credenciais de teste: <code>admin.admin</code> / <code>123456</code></p>
  </div>
</div>
