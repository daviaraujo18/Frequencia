<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>Usuários</h2>
  <%= link_to "Novo Usuário", new_user_path, class: "btn btn-primary" %>
</div>

<div class="card">
  <div class="card-body p-0">
    <table class="table table-striped mb-0">
      <thead>
        <tr>
          <th>ID</th>
          <th>Nome Completo</th>
          <th>Username</th>
          <th>Status</th>
          <th>Digitais</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= user.id %></td>
            <td><%= user.nome_completo %></td>
            <td><code><%= user.username %></code></td>
            <td>
              <% if user.status == 1 %>
                <span class="badge bg-success">Ativo</span>
              <% else %>
                <span class="badge bg-danger">Inativo</span>
              <% end %>
            </td>
            <td>
              <% if user.digitais_hash.present? %>
                <span class="badge bg-info">Cadastrada</span>
              <% else %>
                <span class="badge bg-secondary">Não</span>
              <% end %>
            </td>
            <td>
              <%= link_to "Editar", edit_user_path(user), class: "btn btn-sm btn-outline-primary" %>
              <% if user.status == 1 %>
                <%= button_to "Inativar", user_path(user), method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Tem certeza?" } %>
              <% else %>
                <%= button_to "Excluir", purge_user_path(user), method: :delete, class: "btn btn-sm btn-danger", data: { turbo_confirm: "Tem certeza que deseja excluir definitivamente este usuário?" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
