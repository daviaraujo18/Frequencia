<% content_for :page_title, "Usuários" %>

<div class="row mb-3">
  <div class="col-sm-6">
    <p class="text-muted mb-0"><%= @users.total_count %> usuário(s) cadastrado(s)</p>
  </div>
  <div class="col-sm-6 text-sm-end">
    <%= link_to new_user_path, class: "btn btn-primary" do %>
      <i class="bi bi-person-plus me-1"></i> Novo Usuário
    <% end %>
  </div>
</div>

<div class="card card-primary card-outline">
  <div class="card-header">
    <h3 class="card-title"><i class="bi bi-people me-1"></i> Lista de Usuários</h3>
  </div>
  <!--begin::Card Body-->
  <div class="card-body p-0">
    <%= form_tag users_path, method: :get, data: { turbo: false } do %>
      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
          <thead>
            <tr>
              <th style="width: 35%">Nome Completo</th>
              <th style="width: 18%">Username</th>
              <th style="width: 15%">Status</th>
              <th style="width: 15%">Digitais</th>
              <th class="text-end" style="width: 17%">Ações</th>
            </tr>
            <tr class="table-light align-middle">
              <td class="py-2">
                <%= text_field_tag :nome, params[:nome], class: "form-control form-control-sm", placeholder: "Buscar por nome..." %>
              </td>
              <td class="py-2">
                <%= text_field_tag :username, params[:username], class: "form-control form-control-sm", placeholder: "Buscar username..." %>
              </td>
              <td class="py-2">
                <%= select_tag :status_filtro,
                      options_for_select([["Ativo", "1"], ["Inativo", "0"]], params[:status_filtro]),
                      include_blank: "Todos",
                      class: "form-select form-select-sm" %>
              </td>
              <td class="py-2">
                <%= select_tag :digital,
                      options_for_select([["Com Digital", "1"], ["Sem Digital", "0"]], params[:digital]),
                      include_blank: "Todas",
                      class: "form-select form-select-sm" %>
              </td>
              <td class="text-end py-2">
                <div class="d-flex gap-1 justify-content-end">
                  <%= button_tag class: "btn btn-primary btn-sm", title: "Filtrar" do %>
                    <i class="bi bi-search"></i> Filtrar
                  <% end %>
                  <%= link_to users_path, class: "btn btn-outline-secondary btn-sm", title: "Limpar Filtros" do %>
                    <i class="bi bi-x-lg"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |user| %>
              <tr>
                <td><%= user.nome_completo %></td>
                <td><code><%= user.username %></code></td>
                <td>
                  <% if user.status == 1 %>
                    <span class="badge text-bg-success">Ativo</span>
                  <% else %>
                    <span class="badge text-bg-danger">Inativo</span>
                  <% end %>
                </td>
                <td>
                  <% if user.digitais_hash.present? %>
                    <span class="badge text-bg-info">Cadastrada</span>
                  <% else %>
                    <span class="badge text-bg-secondary">Não</span>
                  <% end %>
                </td>
                <td class="text-end">
                  <div class="d-flex gap-1 justify-content-end">
                    <%= link_to edit_user_path(user), class: "btn btn-xs btn-outline-primary", title: "Editar" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <% if user.status == 1 %>
                      <%= button_to user_path(user), method: :delete, class: "btn btn-xs btn-outline-danger", title: "Inativar", data: { turbo_confirm: "Tem certeza?" } do %>
                        <i class="bi bi-person-x"></i>
                      <% end %>
                    <% else %>
                      <%= button_to purge_user_path(user), method: :delete, class: "btn btn-xs btn-danger", title: "Excluir definitivamente", data: { turbo_confirm: "Tem certeza que deseja excluir definitivamente este usuário?" } do %>
                        <i class="bi bi-trash"></i>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
  <!--end::Card Body-->
  <!--begin::Card Footer-->
  <div class="card-footer clearfix">
    <div class="float-start pt-1 fs-7 text-body-secondary">
      Mostrando <%= @users.offset_value + 1 %> a <%= @users.offset_value + @users.length %> de <%= @users.total_count %> usuários
    </div>
    <%= paginate @users %>
  </div>
  <!--end::Card Footer-->
</div>

